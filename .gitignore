# Dependencias
node_modules
.pnp
.pnp.js

# Build
dist
dist-ssr
dev-dist
build
*.local

# Entorno — nunca subir claves reales
.env
.env.local
.env.*.local
!.env.example

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
*-debug.log
serviceAccountKey.json
*serviceAccount*.json

