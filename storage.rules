rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function esDueno(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function esImagenValida() {
      return request.resource.contentType.matches('image/.*')
             && request.resource.size < 5 * 1024 * 1024; // 5 MB
    }

    // Foto de perfil: usuarios/{uid}/avatar.jpg
    match /usuarios/{uid}/{archivo} {
      allow read: if esDueno(uid);
      allow write: if esDueno(uid) && esImagenValida();
      allow delete: if esDueno(uid);
    }

    // Fotos de alimentos creados por el usuario
    match /alimentos/{uid}/{archivo} {
      allow read: if request.auth != null;
      allow write: if esDueno(uid) && esImagenValida();
      allow delete: if esDueno(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
