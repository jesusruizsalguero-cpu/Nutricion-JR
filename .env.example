# Configuración de Firebase (Web App)
# Consola: https://console.firebase.google.com/project/nutricion-jr/settings/general
# Copia este archivo como `.env` y rellena los valores de tu app web.
#
# Nota: estas claves NO son secretas (van al bundle del navegador). La seguridad
# real vive en firestore.rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=nutricion-jr.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nutricion-jr
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Pon en "true" para conectar a los emuladores locales (firebase emulators:start)
VITE_USAR_EMULADORES=false
